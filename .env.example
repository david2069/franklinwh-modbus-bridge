# Copy to .env and edit BEFORE the first `docker compose up -d --build`.
# Guide: docs/user/install-docker.md

# Runtime environment override (auto-detected if not set)
# APP_ENV=dev          # dev | docker | ha_addon

# Timezone (required). Schedules and tariff windows run on this clock, and the
# bridge records it on first start. Compose won't start until it's set.
TZ=

# First admin, created on first start only. Leave ADMIN_PASSWORD empty and a
# password is generated and printed once in the log
# (docker compose logs app | grep -i password).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Modbus connection
# Leave MODBUS_HOST unset to find and set up the aGate in the web UI's setup
# wizard. Set it to skip the wizard and connect straight away.
# MODBUS_HOST=
MODBUS_PORT=502
# MODBUS_UNIT_ID=1
# MODBUS_POLL_INTERVAL=10

# Setup wizard: LAN subnet to search for the aGate (Docker only). Usually not
# needed — the wizard uses the address you opened the web UI with. Set it when
# you reach the UI through localhost or a reverse proxy. Comma-separated.
# LAN_SUBNET=192.0.2.0/24

# MQTT broker. Under Docker, `mosquitto` is the broker the compose file starts;
# `localhost` would be the bridge's own container. Set in the environment, the
# broker can't be changed from the web UI.
MQTT_HOST=mosquitto
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Logging: DEBUG, INFO, WARNING or ERROR
# LOG_LEVEL=INFO
