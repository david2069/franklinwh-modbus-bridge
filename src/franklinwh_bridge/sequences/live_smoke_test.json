[
  {
    "step": "Enable VPP Mode (Pulse)",
    "writes": {
      "704.WSetEna": 1,
      "704.WSetPct": 5
    },
    "verify": true,
    "verify_timeout_ms": 5000,
    "note": "Low power 5% pulse for connectivity check"
  },
  {
